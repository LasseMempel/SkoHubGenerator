    skos:broader <https://www.w3id.org/archlink/terms/C9D991> ;
    skos:definition "Im Material oder an der Oberfläche sind lösliche Salze angereichert, die hygroskopisch Wasser aufnehmen und langfristig Schäden verursachen können."@de ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "AA3CA7" ;
    skos:prefLabel "versalzen"@de .

