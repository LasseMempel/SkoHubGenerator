    skos:prefLabel "Talkum"@de .

<https://www.w3id.org/archlink/terms/BFCC33> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    skos:altLabel "Erweicht"@de,
        "Weich geworden"@de ;
    skos:broader <https://www.w3id.org/archlink/terms/CB9GD3> ;
    skos:definition "Das Material des Objektes hat durch Wasseraufnahme seine Festigkeit und Formstabilität verloren."@de ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "BFCC33" ;
    skos:prefLabel "aufgeweicht"@de .

<https://www.w3id.org/archlink/terms/BFDB22> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    dcterms:source "DIN EN ISO 8044:2020-08, Korrosion von Metallen und Legierungen - Grundbegriffe (ISO 8044:2020); Dreisprachige Fassung EN ISO 8044:2020, Deutsches Institut für Normung." ;
    skos:altLabel "Transkristalline Korrosion"@de ;
    skos:broader <https://www.w3id.org/archlink/terms/AF5B1A> ;
    skos:definition "Rissbildung bis hin zum vollständigen Versagen des Materials durch Eigenspannungen im Werkstoffgefüge in Kombination mit korrosiven Umgebungsbedingungen (u.a. die Anwesenheit eines Elektrolyten). Erstes Anzeichen einer beginnenden Spannungsrisskorrosion ist eine feine, vielfach verzweigte Rissbildung an Stellen mit hoher Spannung oder Materialdefekten."@de ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "BFDB22" ;
    skos:prefLabel "Spannungsrisskorrosion"@de .

