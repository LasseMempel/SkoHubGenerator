<https://www.w3id.org/archlink/terms/A64281> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    skos:broader <https://www.w3id.org/archlink/terms/GFD582> ;
    skos:definition "Produktname eines lichthärtendes Methacrylharzes der Firma Heraeus Kulzer GmbH und Co. KG"@de ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
