<https://www.w3id.org/archlink/terms/ACD56G> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    dcterms:source "R. Dietrich/ B. Skinner, Die Gesteine und ihre Mineralien. Ein Einführungs- und Bestimmungsbuch2 (Thun 1995), S. 256." ;
    skos:altLabel "Eisenerz"@de,
        "Eisenformation"@de ;
    skos:broader <https://www.w3id.org/archlink/terms/C7F346> ;
    skos:definition "sedimentäres Gestein mit einem Eisengehalt von mehr als 15%. Als eisenmineralien sind häufig u.A. Limonit, Hämatit, Magnetit, Siderit und/oder Pyrit enthalten."@de ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "ACD56G" ;
    skos:prefLabel "eisenreiches Sedimentit"@de .

