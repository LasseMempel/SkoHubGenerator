    skos:altLabel "polierte Fläche"@de ;
    skos:broader <https://www.w3id.org/archlink/terms/BF7FDB> ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "C89AC8" ;
    skos:prefLabel "Politurzone"@de .

<https://www.w3id.org/archlink/terms/C8G54A> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    dcterms:source """Wolfgang Knobloch, Ergänzungen und Rekonstruktionen an historischen Objekten aus Metall. In: Peter Heinrich (Hrsg.), Metallrestaurierung. Beiträge zur Analyse, Konzeption und
Technologie. München 2000, S. 95/96.""" ;
    skos:altLabel "Verzinnung"@de ;
    skos:broader <https://www.w3id.org/archlink/terms/F2244D> ;
    skos:definition "Verzierungstechnik, bei der eine dünne Schicht Zinn auf eine Oberfläche aufgetragen wird. Bei historischen Objekten wurde dies z.B. zur Imitation von Silber oder zur Auskleidung von Kupfergefäßen angewandt."@de ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "C8G54A" ;
    skos:prefLabel "verzinnt"@de .

<https://www.w3id.org/archlink/terms/C911B8> a skos:Concept ;
