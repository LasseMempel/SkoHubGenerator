<https://www.w3id.org/archlink/terms/CC2F8A> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    dcterms:source "https://www.sigmaaldrich.com/DE/de/product/mm/108421" ;
    skos:broader <https://www.w3id.org/archlink/terms/D9F9D8> ;
