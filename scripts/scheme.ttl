<https://www.w3id.org/archlink/terms/CCBB4G> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    dcterms:source "R. Dietrich/ B. Skinner, Die Gesteine und ihre Mineralien. Ein Einführungs- und Bestimmungsbuch2 (Thun 1995), S. 189 - 191." ;
    skos:altLabel "Perlstein"@de ;
    skos:broader <https://www.w3id.org/archlink/terms/B12CB4> ;
    skos:definition "vulkanisches Gesteinsglas mit charakteristischem, perlartigen Aussehen, welches auf zentimetergroßen konzentrisch-schaligen Glaskügelchen in der Matrix zurückzuführen ist. Die Farbigkeit kann von grau, grün, bläulich über rötlich, braun bis hin zu farblos reichen."@de ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "CCBB4G" ;
    skos:prefLabel "Perlit"@de ;
    skos:related <https://www.w3id.org/archlink/terms/DA2D73> .

<https://www.w3id.org/archlink/terms/CD477D> a skos:Concept ;
    dcterms:creator "Kristina Fischer/ LEIZA" ;
    skos:altLabel "Carbonfaser"@de,
        "Kohlenstofffaser"@de ;
    skos:broader <https://www.w3id.org/archlink/terms/BGGCA4> ;
    skos:inScheme <https://www.w3id.org/archlink/terms/conservationthesaurus> ;
    skos:notation "CD477D" ;
